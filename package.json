{
  "name": "webwatch-api",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant website monitoring API with screenshots and alerts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
