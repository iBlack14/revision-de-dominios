NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://webwatch:webwatch@localhost:5432/webwatch
ADMIN_TOKEN=change-this-long-admin-token
SCREENSHOT_SIGNING_SECRET=change-this-separate-long-secret
PUBLIC_BASE_URL=http://localhost:8080
SCREENSHOT_DIR=./data/screenshots
CHECK_CONCURRENCY=2
MAX_MONITORS_PER_CLIENT=50
RETENTION_DAYS=30
ALLOW_PRIVATE_TARGETS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WebWatch <alerts@example.com>
